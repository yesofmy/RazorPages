@page
@model StudentAccounting.Pages.CreateModel

@{
    ViewData["Title"] = "Add Student";
}

<div class="page-heading">
    <div>
        <h1>Add New Student</h1>
        <p class="page-subtitle">
            Enter the information required to create a student record
        </p>
    </div>
</div>

<section class="card form-card">
    <div class="card-header">
        <h2 class="card-title">Student Information</h2>
    </div>

    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-group">
                <label asp-for="Student.FullName">Full Name</label>
                <input asp-for="Student.FullName"
                       class="form-control"
                       placeholder="e.g. John Smith" />
                <span asp-validation-for="Student.FullName"></span>
            </div>

            <div class="form-group">
                <label asp-for="Student.Group">Academic Group</label>
                <input asp-for="Student.Group"
                       class="form-control"
                       placeholder="e.g. CS-31" />
                <span asp-validation-for="Student.Group"></span>
            </div>

            <div class="form-group">
                <label asp-for="Student.AverageGrade">Average Grade</label>
                <input asp-for="Student.AverageGrade"
                       class="form-control"
                       type="number"
                       min="0"
                       max="100"
                       step="0.01"
                       placeholder="e.g. 91.50" />
                <span asp-validation-for="Student.AverageGrade"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    Save Student
                </button>
                <a asp-page="/Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</section>