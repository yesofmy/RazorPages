@page
@model StudentAccounting.Pages.IndexModel

@{
    ViewData["Title"] = "Student List";
}

<div class="page-heading">
    <div>
        <h1>Student Management</h1>
        <p class="page-subtitle">
            View and manage student records
        </p>
    </div>
    <a asp-page="/Create" class="btn btn-primary">
        + Add Student
    </a>
</div>

<div class="summary-grid">
    <div class="summary-card">
        <div class="summary-icon">♙</div>
        <div>
            <div class="summary-label">Total Students</div>
            <div class="summary-value">@Model.Students.Count</div>
        </div>
    </div>
    <div class="summary-card">
        <div class="summary-icon">▤</div>
        <div>
            <div class="summary-label">Academic Groups</div>
            <div class="summary-value">
                @Model.Students.Select(s => s.Group).Distinct().Count()
            </div>
        </div>
    </div>
</div>

<section class="card">
    <div class="card-header">
        <h2 class="card-title">Student List</h2>
        <span class="page-subtitle">Records: @Model.Students.Count</span>
    </div>

    @if (Model.Students.Count == 0)
    {
        <div class="empty-state">
            <strong>No students yet</strong>
            Add your first student to get started.
            <p>
                <a asp-page="/Create" class="btn btn-primary">
                    + Add Student
                </a>
            </p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Academic Group</th>
                        <th>Average Grade</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td class="student-id">@student.Id</td>
                            <td class="student-name">@student.FullName</td>
                            <td>
                                <span class="group-badge">@student.Group</span>
                            </td>
                            <td>
                                <span class="grade-badge">
                                    @student.AverageGrade.ToString("0.##")
                                </span>
                            </td>
                            <td>
                                <div class="actions">
                                    <a asp-page="/Edit"
                                       asp-route-id="@student.Id"
                                       class="btn btn-edit">
                                        Edit
                                    </a>

                                    <form method="post"
                                          asp-page-handler="Delete"
                                          asp-route-id="@student.Id">
                                        <button type="submit"
                                                class="btn btn-danger"
                                                onclick="return confirm('Are you sure you want to delete this student?')">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>