@page "{handler?}"
@model ProductCatalog.Pages.IndexModel
@inject ProductCatalog.Services.IProductService ProductService

@{
    ViewData["Title"] = "Product Catalog";
}

<div class="hero">

    <div class="hero-content">
        <span class="hero-label">ASP.NET CORE • RAZOR PAGES</span>

        <h1>Modern Product Catalog</h1>

        <p>
            Explore our products and learn how routing,
            dependency injection and page handlers work together.
        </p>

        <div class="hero-actions">
            <a href="#catalog" class="btn btn-primary">
                Explore Products
            </a>

            <a asp-page="/Index"
               asp-route-handler="DownloadReport"
               class="btn btn-secondary">
                Download Report
            </a>
        </div>
    </div>

</div>

<main class="catalog-container" id="catalog">

    <section class="section-heading">
        <div>
            <span class="section-label">OUR PRODUCTS</span>
            <h2>Product Catalog</h2>
        </div>

        <div class="render-info">
            <span>Page generated at</span>
            <strong>@ViewData["RenderTime"]</strong>
        </div>
    </section>

    <div class="filter-card">

        <div>
            <h3>Find affordable products</h3>
            <p>
                Show products with a price lower than the selected value.
            </p>
        </div>

        <form method="get" class="filter-form">

            <input type="hidden" name="handler" value="Cheap" />

            <input
                type="number"
                name="maxPrice"
                min="1"
                step="0.01"
                value="100"
                placeholder="Maximum price" />

            <button type="submit" class="btn btn-primary">
                Filter
            </button>

            <a asp-page="/Index" class="btn btn-light">
                All Products
            </a>

        </form>

    </div>

    <div class="products-grid">

        @foreach (var product in Model.Products)
        {
            <article class="product-card">

                <div class="product-number">
                    #@product.Id.ToString("00")
                </div>

                <div class="product-content">

                    <span class="product-category">
                        FEATURED PRODUCT
                    </span>

                    <h3>@product.Name</h3>

                    <div class="product-bottom">

                        <div class="price">
                            $@product.Price.ToString("0.00")
                        </div>

                        <a asp-page="/Details"
                           asp-route-id="@product.Id"
                           class="details-link">
                            View Details →
                        </a>

                    </div>

                </div>

            </article>
        }

    </div>

</main>

<footer class="site-footer">

    <div>
        <strong>ProductCatalog</strong>
        <span>ASP.NET Core Razor Pages Laboratory</span>
    </div>

    <div class="footer-info">
        <span>
            Total products:
            <strong>@ProductService.GetProducts().Count</strong>
        </span>

        <span>
            © 2026 ProductCatalog
        </span>
    </div>

</footer>