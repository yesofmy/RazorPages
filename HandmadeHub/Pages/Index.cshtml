@page
@model HandmadeHub.Pages.IndexModel

@{
    ViewData["Title"] = "Catalog";
}

<section class="hero">
    <div class="hero-copy">
        <span class="eyebrow">YOUR CREATIVE WORKSHOP</span>
        <h1>Ideas come to life<br />in your hands<span>.</span></h1>
        <p>Discover materials, tools, and inspiration
           for your next handmade project.</p>
        <a asp-page="/Create" class="btn btn-primary">
            Add a Product <span>↗</span>
        </a>
    </div>

    <div class="hero-art">
        <div class="art-circle"></div>
        <div class="art-label">MADE WITH<br />LOVE ♡</div>
        <div class="art-flower">✿</div>
    </div>
</section>

<section class="catalog-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">EVERYTHING FOR CREATIVITY</span>
            <h2>Our Catalog</h2>
        </div>
        <span class="count-badge">@Model.Products.Count products</span>
    </div>

    @if (Model.Products.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">✿</span>
            <h3>Your Creativity Starts Here</h3>
            <p>The catalog is empty. Add your first product!</p>
            <a asp-page="/Create" class="btn btn-primary">
                Create a Product
            </a>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model.Products)
            {
                <article class="product-card">
                    <a asp-page="/Details"
                       asp-route-id="@product.Id"
                       class="product-image">
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <img src="@product.ImagePath"
                                 alt="@product.Title" />
                        }
                        else
                        {
                            <div class="image-placeholder">✳</div>
                        }

                        <span class="category-tag">@product.Category</span>
                    </a>

                    <div class="product-info">
                        <h3>
                            <a asp-page="/Details"
                               asp-route-id="@product.Id">
                                @product.Title
                            </a>
                        </h3>

                        <div class="product-bottom">
                            <span class="price">
                                @product.Price.ToString("N2") UAH
                            </span>
                            <a asp-page="/Details"
                               asp-route-id="@product.Id"
                               class="arrow-link"
                               aria-label="View details">↗</a>
                        </div>

                        <div class="card-actions">
                            <a asp-page="/Edit"
                               asp-route-id="@product.Id">Edit</a>

                            <form method="post"
                                  asp-page-handler="Delete"
                                  asp-route-id="@product.Id"
                                  onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <button type="submit" class="delete-link">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>