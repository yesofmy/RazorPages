@page
@model HandmadeHub.Pages.CreateModel

@{
    ViewData["Title"] = "Add Product";
}

<div class="form-page">
    <a asp-page="/Index" class="back-link">← Back to Catalog</a>

    <div class="form-heading">
        <span class="eyebrow">YOUR CREATIVE COLLECTION</span>
        <h1>Add a Product<span>.</span></h1>
        <p>Enter the details below to add a new product to the catalog.</p>
    </div>

    <form method="post" enctype="multipart/form-data"
          class="product-form">
        <div asp-validation-summary="ModelOnly"
             class="validation-summary"></div>

        <div class="field">
            <label asp-for="Product.Title"></label>
            <input asp-for="Product.Title"
                   placeholder="For example, Bead Kit" />
            <span asp-validation-for="Product.Title"
                  class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Product.Category"></label>
            <select asp-for="Product.Category"
                    asp-items="Model.Categories">
                <option value="">Select a category</option>
            </select>
            <span asp-validation-for="Product.Category"
                  class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Product.Price"></label>
            <div class="price-input">
                <input asp-for="Product.Price"
                       type="number" step="0.01" min="0.01"
                       placeholder="0.00" />
                <span>₴</span>
            </div>
            <span asp-validation-for="Product.Price"
                  class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Upload">Product Image</label>
            <input asp-for="Upload" type="file"
                   accept=".jpg,.jpeg,.png,.webp" />
            <small>JPG, PNG, or WEBP. Maximum size: 5 MB.</small>
            <span asp-validation-for="Upload"
                  class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                Save Product ↗
            </button>
            <a asp-page="/Index" class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}