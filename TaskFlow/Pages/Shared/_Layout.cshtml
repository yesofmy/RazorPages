@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111827" />
    <title>@ViewData["Title"] | TaskFlow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-page="/Index">
                <span class="brand-icon">T</span>
                <span class="brand-name">taskflow<span class="brand-period">.</span></span>
            </a>

            <div class="workspace-label">WORKSPACE</div>

            <nav class="sidebar-nav">
                <a class="nav-link @(currentPage == "/Index" ? "active" : "")"
                   asp-page="/Index">
                    <span class="nav-icon">▦</span>
                    <span>Dashboard</span>
                </a>

                <a class="nav-link @(currentPage == "/Create" ? "active" : "")"
                   asp-page="/Create">
                    <span class="nav-icon">＋</span>
                    <span>Create task</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <div class="sidebar-profile">
                    <div class="avatar">TF</div>
                    <div class="profile-text">
                        <strong>TaskFlow User</strong>
                        <span>Personal workspace</span>
                    </div>
                    <span class="profile-menu">···</span>
                </div>
                <div class="sidebar-version">
                    <span class="online-indicator"></span>
                    TaskFlow <span class="version-tag">v1.0</span>
                </div>
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div class="breadcrumb">
                    <span>Workspace</span>
                    <span class="breadcrumb-separator">/</span>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <div class="topbar-right">
                    <span class="environment-label">LOCAL ENVIRONMENT</span>
                    <span class="topbar-avatar">TF</span>
                </div>
            </header>

            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© @DateTime.Now.Year TaskFlow</span>
                <span>Built with ASP.NET Core Razor Pages</span>
            </footer>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>