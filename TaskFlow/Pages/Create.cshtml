@page
@model TaskFlow.Pages.CreateModel
@{
    ViewData["Title"] = "Create task";
}

<div class="back-navigation">
    <a asp-page="/Index" class="back-link">← Back to dashboard</a>
</div>

<section class="form-page-heading">
    <div class="eyebrow">TASK MANAGEMENT / NEW TASK</div>
    <h1>Create a new task<span class="heading-period">.</span></h1>
    <p class="page-subtitle">
        Add the details below to create a task in your workspace.
    </p>
</section>

<section class="content-panel create-panel">
    <div class="panel-header">
        <div>
            <h2>Task information</h2>
            <p class="section-description">Fields marked with * are required.</p>
        </div>
        <span class="required-note"><span>*</span> Required fields</span>
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-field">
            <label asp-for="Input.Title" class="form-label">
                Task title <span>*</span>
            </label>
            <input asp-for="Input.Title"
                   class="form-control"
                   placeholder="e.g. Prepare project documentation"
                   maxlength="100" />
            <span asp-validation-for="Input.Title" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.Description" class="form-label">
                Description
            </label>
            <textarea asp-for="Input.Description"
                      class="form-control textarea-control"
                      rows="5"
                      maxlength="1000"
                      placeholder="Describe the task, expected result, or additional details..."></textarea>
            <div class="input-hint">Provide enough information to make the task clear.</div>
            <span asp-validation-for="Input.Description" class="field-error"></span>
        </div>

        <div class="form-grid">
            <div class="form-field">
                <label asp-for="Input.Priority" class="form-label">
                    Priority <span>*</span>
                </label>
                <select asp-for="Input.Priority" class="form-control">
                    <option value="High">High priority</option>
                    <option value="Medium">Medium priority</option>
                    <option value="Low">Low priority</option>
                </select>
                <span asp-validation-for="Input.Priority" class="field-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="Input.AttachedFileName" class="form-label">
                    Attachment file name
                </label>
                <input asp-for="Input.AttachedFileName"
                       class="form-control"
                       maxlength="150"
                       placeholder="e.g. project-notes.txt" />
                <div class="input-hint">Enter a file name only. This field does not upload a physical file.</div>
                <span asp-validation-for="Input.AttachedFileName" class="field-error"></span>
            </div>
        </div>

        <div class="form-divider"></div>

        <div class="form-actions">
            <button type="submit" class="button button-primary">
                <span class="button-icon">＋</span>
                Create task
            </button>

            <a asp-page="/Index" class="button button-secondary">
                Cancel
            </a>
        </div>
    </form>
</section>