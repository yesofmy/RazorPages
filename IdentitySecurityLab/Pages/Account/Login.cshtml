@page
@model IdentitySecurityLab.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-icon">&#8594;</div>
        <h1>Welcome back</h1>
        <p class="auth-subtitle">
            Sign in to continue to your account.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="validation-error"></div>

            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group">
                <label asp-for="Input.Email">Email address</label>
                <input asp-for="Input.Email"
                       class="form-control"
                       placeholder="you@example.com"
                       autocomplete="username" />
                <span asp-validation-for="Input.Email"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password" />
                <span asp-validation-for="Input.Password"
                      class="validation-error"></span>
            </div>

            <div class="remember-row">
                <input asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe">
                    Remember me
                </label>
            </div>

            <button type="submit" class="auth-button">
                Sign in
            </button>
        </form>

        <p class="auth-footer">
            Don't have an account?
            <a asp-page="./Register">Create an account</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
