@page
@model IdentitySecurityLab.Areas.Identity.Pages.Account.LogoutModel

@{
    ViewData["Title"] = "Sign Out";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-icon">&#8592;</div>
        <h1>Sign out</h1>
        <p class="auth-subtitle">
            Are you sure you want to sign out of your account?
        </p>

        <form method="post">
            <button type="submit" class="auth-button">
                Sign out
            </button>
        </form>

        <p class="auth-footer">
            <a asp-page="/Index" asp-area="">
                Back to home
            </a>
        </p>
    </div>
</div>
