@page
@model IdentitySecurityLab.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-icon">+</div>
        <h1>Create account</h1>
        <p class="auth-subtitle">Join Identity Security today.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="validation-error"></div>

            <div class="form-group">
                <label asp-for="Input.Email">Email address</label>
                <input asp-for="Input.Email"
                       class="form-control"
                       placeholder="you@example.com"
                       autocomplete="email" />
                <span asp-validation-for="Input.Email"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password"
                       class="form-control"
                       placeholder="Create a strong password"
                       autocomplete="new-password" />
                <span asp-validation-for="Input.Password"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">
                    Confirm password
                </label>
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       placeholder="Repeat your password"
                       autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword"
                      class="validation-error"></span>
            </div>

            <button type="submit" class="auth-button">
                Create account
            </button>
        </form>

        <p class="auth-footer">
            Already have an account?
            <a asp-page="./Login">Sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
